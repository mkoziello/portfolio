    "_comment": [
        "Model manifest for 3Dviewer.html. One .glb in models/ + one entry here.",
        "Texture naming: <name>_A base colour, _M metallic, _R roughness,",
        "_AO ambient occlusion, _N normal. The JSON keys below are the viewer's",
        "material slots and don't change; only the filenames follow the suffixes.",
        "With _M and _R maps supplied, keep material.metalness and .roughness at",
        "1.0 — three.js multiplies the map by the scalar, so anything lower",
        "darkens the whole map."
    ],
    "models": [
        {
            "id": "vv-logo",
            "name": "VertexVoodoo Logo",
            "group": "Branding",
            "file": "models/VV_logo_3d.glb",
            "tags": [ "Blender 4.5", "glTF 2.0", "Vertex colors" ],
            "note": "Studio mark, extruded from the 2D logotype and baked down to vertex colours so it carries no textures at all. 62 verts, 32 tris.",
            "material": {
                "metalness": 0.85,
                "roughness": 0.28,
                "tint": "#ffffff",
                "vertexColors": true,
                "envIntensity": 1.0
            },
            "view": {
                "autoOrbit": true,
                "exposure": 1.0,
                "grid": true,
                "shadow": true,
                "fit": "ground"
            }
